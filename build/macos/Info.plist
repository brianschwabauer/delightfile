<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  delightfile.app's Info.plist (plans/other-platforms/06-build-and-release.md
  B6.15). build/macos/bundle.sh copies it into the bundle and fills the three
  placeholders: the version from Cargo.toml's [workspace.package], and the
  lowest macOS the bundle can start on, which is the newest `minos` among the
  program and the libraries it carries, because dyld refuses a library built
  for a newer macOS than the one running.

  CFBundleDocumentTypes offers the app for folders in Finder's Open With, at
  Alternate rank, so it never takes over from Finder by itself.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>delightfile</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>delightfile</string>
	<key>CFBundleIconFile</key>
	<string>delightfile.icns</string>
	<key>CFBundleIdentifier</key>
	<string>com.showandtour.delightfile</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>delightfile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MINIMUM_SYSTEM_VERSION@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
