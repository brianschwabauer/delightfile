// delightfile.exe's resources (plans/other-platforms/06-build-and-release.md
// B6.20): the icon Explorer and the taskbar show, and the version Explorer's
// Properties > Details lists. crates/df-app/build.rs compiles this with the
// Windows SDK's rc.exe (or llvm-rc) and links the result into the program.
//
// build.rs writes delightfile-version.h beside the compiled resource: the
// DF_VERSION_* numbers and the DF_VERSION string from Cargo.toml, and
// DF_ICON when delightfile.ico, which build/windows/icon.ps1 draws, is here.
// No Windows SDK header is included, so rc needs no INCLUDE path: the
// VERSIONINFO constants are written out (VOS_NT_WINDOWS32, VFT_APP).

#include "delightfile-version.h"

#ifdef DF_ICON
// The lowest-numbered icon group is the one Explorer shows for the file.
1 ICON "delightfile.ico"
#endif

1 VERSIONINFO
FILEVERSION DF_VERSION_MAJOR, DF_VERSION_MINOR, DF_VERSION_PATCH, 0
PRODUCTVERSION DF_VERSION_MAJOR, DF_VERSION_MINOR, DF_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "delightfile"
            VALUE "FileVersion", DF_VERSION
            VALUE "InternalName", "delightfile"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "delightfile.exe"
            VALUE "ProductName", "delightfile"
            VALUE "ProductVersion", DF_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
